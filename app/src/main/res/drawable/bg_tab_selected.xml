<?xml version="1.0" encoding="utf-8"?>
<!--
  Selected-tab fill. Was hardcoded to #2A0000 (a dark red, this app's emergency palette) before —
  visually wrong on a screen with no error state, so recoloured to the accent theme used everywhere
  else. Colour alone still isn't the only signal: LessonActivity also bolds the selected tab's text
  and sets android:state_selected, so a colour-blind or screen-reader user has two more cues.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/accent_dim" />
    <corners android:radius="8dp" />
    <stroke
        android:width="1dp"
        android:color="@color/accent" />
</shape>
