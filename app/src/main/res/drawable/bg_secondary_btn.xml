<?xml version="1.0" encoding="utf-8"?>
<!--
  Secondary full-width button: outlined, same 28dp corner radius as the primary pill so the two read
  as a pair.

  Not reusing the source project's bg_swap_btn: that was drawn as an oval for a small square swap
  control, and an oval stretched to full width renders as a lozenge.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="@color/accent_dim" />
            <stroke
                android:width="1dp"
                android:color="@color/accent" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="@color/text_disabled" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="@color/divider_light" />
        </shape>
    </item>
</selector>
