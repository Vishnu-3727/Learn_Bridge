<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup rules for API 30 and below. Wired up by AndroidManifest's
  android:fullBackupContent — this file does nothing unless that attribute names it.

  API 30 and below have no separate device-transfer channel, so everything here is about cloud
  backup, and the document database is excluded for the reason given in data_extraction_rules.xml:
  the study material a student photographs is not ours to upload, and the system performs Auto
  Backup whether or not this app can reach the network.

  filesDir and app-specific external storage hold the regenerable .ort graph caches and the
  one-shot extracted .onnx sources — hundreds of megabytes against a ~25 MB quota, all rebuilt on
  next launch. The chosen teaching language and the model-residency flags live in sharedpref and
  are carried by omission.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
