<?xml version="1.0" encoding="utf-8"?>
<!--
  Two named subdirectories of app-private files, and nothing else. Neither is a whole-of-filesDir
  grant: the documents, the database and the extracted text stay unreachable to every other app.

  captures/ so the system camera can write a photographed page in via ACTION_IMAGE_CAPTURE.
  export/   so the student can send their own Learning Twin somewhere. That is the one path by
            which anything leaves this app, and it only opens when they ask for it.
-->
<paths>
    <files-path
        name="captures"
        path="captures/" />
    <files-path
        name="export"
        path="export/" />
</paths>
